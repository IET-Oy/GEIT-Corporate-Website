{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && corepack pnpm run build && corepack pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:inspect:platform": "node scripts/migrate-platform.mjs",
    "db:migrate:platform": "node scripts/migrate-platform.mjs --apply",
    "test:platform": "node scripts/test-platform.mjs",
    "test:pkce": "tsx --test scripts/test-platform-pkce.mjs",
    "test:readiness": "tsx --test tests/readiness.test.ts",
    "test:auth-outages": "tsx --test tests/auth-outage.test.ts",
    "test:safe": "tsx --test tests/*.test.ts scripts/test-platform-pkce.mjs",
    "test:production": "node scripts/test-production-smoke.mjs",
    "audit:database": "node scripts/audit-database.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "test:energy": "tsx --test tests/energy.test.ts",
    "test:energy:integration": "node scripts/test-platform.mjs --energy",
    "test:engineering": "tsx --test tests/engineering.test.ts",
    "test:engineering:integration": "node scripts/test-platform.mjs --engineering",
    "test:sustainability": "tsx --test tests/sustainability.test.ts",
    "test:sustainability:integration": "node scripts/test-platform.mjs --sustainability"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
