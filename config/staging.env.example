# DOCUMENTATION ONLY. Do not source this file in the existing application.
# Enter actual values through Secrets/settings in a SEPARATE staging workspace.
# No values or project targets are supplied intentionally.
GEIT_ENVIRONMENT=staging
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
SESSION_SECRET=
PLATFORM_ORIGIN=
