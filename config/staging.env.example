DATABASE_URL=
GEIT_TEST_SUPABASE_PROJECT_REF=
GEIT_STAGING_APPROVAL_FILE=
GEIT_ALLOW_TEST_FIXTURE_WRITES=no
GEIT_AI_ENABLED=false
